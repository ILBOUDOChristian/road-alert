# =============================================================================
# ROADALERT — .env.example (DÉVELOPPEMENT)
# Modèle de développement : le script le copie dans .env.dev si nécessaire.
# Le backend reçoit les variables via l'environnement Docker Compose.
#
# Production : même clés sur le serveur, autres VALEURS
# (NODE_ENV=production, https://, secrets, CORS du front déployé).
# Ne jamais mélanger hôtes locaux et hôtes de prod dans le même fichier actif.
# =============================================================================

NODE_ENV=development

# --- URLs (loopback uniquement) ---
APP_URL=http://roadalert.com
API_URL=http://roadalert.com/api/v1
CORS_ORIGINS=http://roadalert.com,http://localhost:*
API_PREFIX=api/v1

PORT=3000
BACKEND_HOST_PORT=3001

# --- PostgreSQL (identifiants Adminer + Nest) ---
# Adminer http://adminer.roadalert.com → Système: PostgreSQL | Serveur: db
DB_HOST=localhost
DB_PORT=5433
DB_USER=roadalert
DB_PASSWORD=roadalert_dev
DB_NAME=roadalert

# --- JWT ---
JWT_SECRET=change-me-dev-only
JWT_EXPIRES_IN=15m

# --- MinIO (S3) ---
MINIO_ROOT_USER=roadalert
MINIO_ROOT_PASSWORD=roadalert_minio_dev
S3_ENDPOINT=http://storage.roadalert.com
S3_ACCESS_KEY=roadalert
S3_SECRET_KEY=roadalert_minio_dev
S3_BUCKET=roadalert

# --- Redis (cache / files d'attente Nest+Bull plus tard) ---
# Pas de Celery ni Flower dans cette configuration.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=roadalert_redis_dev
REDIS_URL=redis://:roadalert_redis_dev@localhost:6379/0

# --- SMTP (Mailhog en local : UI http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_SECURE=false
